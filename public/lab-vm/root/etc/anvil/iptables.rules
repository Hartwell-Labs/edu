# Zrzut regul, ktorych masz uzasadnicia. Czytasz plik, nie ruszasz go.
*filter
:INPUT ACCEPT [0:0]
:FORWARD DROP [0:0]
-A INPUT -i lo -j ACCEPT
-A INPUT -i eth0 -p tcp --dport 22 -j ACCEPT
-A INPUT -i eth0 -p tcp --dport 8080 -j ACCEPT
-A INPUT -i eth1 -p tcp --dport 8080 -j ACCEPT
-A INPUT -i eth0 -p tcp --dport 3306 -j DROP
COMMIT
